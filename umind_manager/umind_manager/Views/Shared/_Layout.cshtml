<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - umind_manager</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <!-- yuilib CDN CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/BlackHunterCode/uilib-yui-cdn@feature/criacao-lib/src/styles/yuilib.css" />

    <!-- yuilib CDN JS -->
    <script src="https://cdn.jsdelivr.net/gh/BlackHunterCode/uilib-yui-cdn@feature/criacao-lib/src/tools/yuilib.js"></script>

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/umind_manager.styles.css" asp-append-version="true" />
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark px-3 py-2 shadow-sm">
            <div class="container-fluid d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <a href="Home">
                        <img src="~/images/umind.png" alt="Umind" width="100" class="me-2">
                    </a>
                    <div style="width: 2px; height: 40px; background: gray; border-radius: 50px; margin: 0 10px;"></div>
                    <button class="y-sidebar-open-btn" onclick="openSidebar()">☰</button>
                    <div class="y-sidebar closed" id="mySidebar">
                        <div class="y-sidebar-header">
                            Menu
                            <button class="y-sidebar-close-btn" onclick="closeSidebar()">×</button>
                        </div>

                        <nav class="y-sidebar-nav">
                            <ul>
                                <li><a style="color: #cfd8dc" href="/Home">Home</a></li>
                                <li><a style="color: #cfd8dc" href="/BookManager">Gerenciador de Livros</a></li>
                            </ul>
                        </nav>

                        <div class="y-sidebar-footer">
                            &copy; 2025 Black Hunter
                        </div>
                    </div>
                    <span class="text-light fw-semibold fs-5">@ViewData["Title"]</span>
                </div>
                <div class="d-flex align-items-center">
                    <input class="y-input" type="search" placeholder="Write a description" aria-label="Search">
                    <div style="width: 2px; height: 40px; background: gray; border-radius: 50px; margin: 0 10px;"></div>
                    <img src="~/images/user-avatar.jpg" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                    <span class="text-light">Alexandre</span>
                    <i class="bi bi-caret-down-fill text-light ms-1"></i>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            &copy; 2025 - umind_manager - <a asp-area="" asp-controller="BookManager" asp-action="Index">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
